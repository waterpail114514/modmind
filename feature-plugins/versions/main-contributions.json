      "id": "query",
      "handler": "query",
      "permission": "read",
      "projectRequired": true,
      "surfaces": [
        "workbench",
        "inspiration"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "status",
              "diff",
              "remotes",
              "snapshots"
            ]
          },
          "path": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": false
      }
