    {
      "id": "manage",
      "handler": "manage",
      "permission": "write",
      "projectRequired": true,
      "surfaces": [
        "workbench"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "initialize",
              "commit",
              "createBranch",
              "fetch",
              "pull",
              "push",
              "merge",
              "rebase",
              "deleteSnapshots"
            ]
          },
          "commit": {
            "type": "object"
          },
          "name": {
            "type": "string"
          },
          "remote": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "confirmed": {
            "type": "boolean"
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": false
      }
    }
  ],
  "tools": [
    {
      "name": "modmind_version_query",
      "action": "query",
      "description": "Read the current project Git status, diff or remote list using the version-management service. Use operation=snapshots to list/search current-project snapshot summaries with query/offset/limit; follow nextOffset."
    },
    {
      "name": "modmind_version_manage",
      "action": "manage",
      "description": "Perform version-management commands in the current project: initialize, commit, createBranch, fetch, pull, push, merge or rebase. Use operation-specific fields and review project status before changes. deleteSnapshots permanently removes the explicit ids after the user confirms (confirmed=true). Migration and active AI recovery backups remain protected. Returns deletedIds, per-item failures, and remainingCount; never imply failed items were removed."
    }
  ]
