    {
      "id": "read",
      "handler": "read",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "list",
              "event",
              "draft",
              "preview"
            ]
          },
          "view": {
            "type": "string",
            "enum": [
              "events",
              "tracks"
            ]
          },
          "query": {
            "type": "string",
            "maxLength": 160
          },
          "source": {
            "type": "string",
            "enum": [
              "all",
              "project",
              "vanilla",
              "pack",
              "mod",
              "library"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "all",
              "effect",
              "music",
              "unknown"
            ]
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "key": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        }
      },
      "permission": "read",
      "projectRequired": true,
      "surfaces": [
        "workbench",
        "inspiration"
      ]
    },
    {
      "id": "create",
      "handler": "create",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "save-event",
              "save-draft",
              "export",
              "process",
              "undo"
            ]
          },
          "event": {
            "type": "object"
          },
          "draft": {
            "type": "object"
          },
          "expectedRevision": {
            "type": "string"
          },
          "process": {
            "type": "object"
          }
        }
      },
      "permission": "write",
      "projectRequired": true,
      "surfaces": [
        "workbench"
      ]
    }
  ],
  "tools": [
    {
      "name": "modmind_sound_library",
      "action": "read",
      "description": "Read the current Java mod project sound library, one event, the editable studio draft, or preview one locally available audio item. List is paged; preview never downloads Minecraft assets and is limited to 4 MiB."
    },
    {
      "name": "modmind_sound_create",
      "action": "create",
      "description": "Edit a project sound event, save an editable sound studio draft, render and export a studio draft as OGG, process an existing audio item, or undo the latest sound change. Uses the same project service as the UI. Read the current draft/event revision first; exports write project audio and sounds.json."
    }
  ]
