  "tools": [
    {
      "name": "modmind_modpack_download_content",
      "action": "modpack_download_content",
      "description": "Download arbitrary HTTPS modpack content through ModMind verified download, size limits, hashing, inventory tracking, and safe world extraction. Covers config, scripts, datapacks, quests, resource packs, shader packs, UI files, worlds, client/server files, and other pack content."
    },
    {
      "name": "modmind_modpack_apply_keybinds",
      "action": "modpack_apply_keybinds",
      "description": "Apply a keybind preset to pack options.txt and reject conflicts by default."
    }
  ]
