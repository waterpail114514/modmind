  "tools": [
    {
      "name": "modmind_modpack_migration_targets",
      "action": "modpack_migration_targets",
      "description": "List supported Minecraft and Loader targets for migrating the active modpack."
    },
    {
      "name": "modmind_modpack_migration_preview",
      "action": "modpack_migration_preview",
      "description": "Scan the active modpack against a target and return official files, replacements, source ports, missing or unknown mods, MC百科 evidence, custom content, and source JAR dossiers without changing the project."
    },
    {
      "name": "modmind_modpack_migration_apply",
      "action": "modpack_migration_apply",
      "description": "Apply migration decisions in the original project directory. Defaults to backup mode and permits deferred unresolved mods. Mod actions: use-compatible, use-replacement, manual-file, create-compat-module, remove, or defer."
    },
    {
      "name": "modmind_modpack_migration_history",
      "action": "modpack_migration_history",
      "description": "Read migration records, incomplete results, reports, backup availability, and undo state."
    },
    {
      "name": "modmind_modpack_migration_undo",
      "action": "modpack_migration_undo",
      "description": "Undo a backup-mode migration. ModMind always snapshots the current post-migration state before restoring the source snapshot."
    }
  ]
