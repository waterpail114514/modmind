{
  "format": "modmind-feature",
  "apiVersion": 2,
  "hostVersion": "1.5.0-plugintest",
  "id": "mc-pull",
  "name": "本地游戏资源",
  "version": "1.15.0",
  "description": "供建筑预览、数据包等功能按需读取本地实例资源，自动随依赖安装；在使用位置选择和管理来源。",
  "main": "main.cjs",
  "renderer": "renderer.js",
  "style": "renderer.css",
  "hostCapabilities": [
    "runtime"
  ],
  "dependencies": [],
  "views": [],
  "capabilities": [
    {
      "id": "mc-pull",
      "name": "本地游戏资源",
      "description": "按项目共用本地实例名称、方块与基础图标；可导入已有探针结果，未附带探针。"
    }
  ],
  "actions": [
    {
      "id": "pull:status",
      "handler": "pull_status",
      "permission": "read",
      "projectRequired": true,
      "surfaces": [
        "workbench"
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectPath": {
            "type": "string",
            "maxLength": 1024
          },
          "instanceDir": {
            "type": "string",
            "maxLength": 512
          },
          "probeDir": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    {
      "id": "pull:run",
      "handler": "pull_run",
      "permission": "write",
      "projectRequired": true,
      "surfaces": [
        "workbench"
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectPath": {
            "type": "string",
            "maxLength": 1024
          },
          "instanceDir": {
            "type": "string",
            "maxLength": 512
          },
          "maxIcons": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "id": "pull:installProbe",
      "handler": "pull_install_probe",
      "permission": "write",
      "projectRequired": true,
      "surfaces": [
        "workbench"
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectPath": {
            "type": "string",
            "maxLength": 1024
          },
          "instanceDir": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    {
      "id": "pull:importProbe",
      "handler": "pull_import_probe",
      "permission": "write",
      "projectRequired": true,
      "surfaces": [
        "workbench"
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectPath": {
            "type": "string",
            "maxLength": 1024
          },
          "instanceDir": {
            "type": "string",
            "maxLength": 512
          },
          "probeDir": {
            "type": "string",
            "maxLength": 512
          },
          "outPx": {
            "type": "integer",
            "minimum": 0
          },
          "maxPages": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "id": "pull:cancel",
      "handler": "pull_cancel",
      "permission": "write",
      "projectRequired": true,
      "surfaces": [
        "workbench"
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectPath": {
            "type": "string",
            "maxLength": 1024
          },
          "on": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "id": "pull:select",
      "handler": "pull_select",
      "permission": "write",
      "projectRequired": true,
      "surfaces": [
        "workbench"
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key"
        ],
        "properties": {
          "projectPath": {
            "type": "string",
            "maxLength": 1024
          },
          "key": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_一-鿿][A-Za-z0-9_.一-鿿-]{0,127}$"
          }
        }
      }
    },
    {
      "id": "pull:clear",
      "handler": "pull_clear",
      "permission": "write",
      "projectRequired": true,
      "surfaces": [
        "workbench"
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key"
        ],
        "properties": {
          "projectPath": {
            "type": "string",
            "maxLength": 1024
          },
          "key": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_一-鿿][A-Za-z0-9_.一-鿿-]{0,127}$"
          }
        }
      }
    },
    {
      "id": "pull:exportPack",
      "handler": "pull_export_pack",
      "permission": "write",
      "projectRequired": true,
      "surfaces": [
        "workbench"
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectPath": {
            "type": "string",
            "maxLength": 1024
          },
          "key": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_一-鿿][A-Za-z0-9_.一-鿿-]{0,127}$"
          }
        }
      }
    },
    {
      "id": "pull:launch",
      "handler": "pull_launch",
      "permission": "process",
      "projectRequired": true,
      "surfaces": [
        "workbench"
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectPath": {
            "type": "string",
            "maxLength": 1024
          },
          "instanceDir": {
            "type": "string",
            "maxLength": 512
          },
          "dryRun": {
            "type": "boolean"
          },
          "maxMemoryMb": {
            "type": "integer",
            "minimum": 1024
          }
        }
      }
    },
    {
      "id": "pull:chooseInstance",
      "handler": "pull_choose_instance",
      "permission": "read",
      "projectRequired": true,
      "surfaces": [
        "workbench"
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectPath": {
            "type": "string",
            "maxLength": 1024
          }
        }
      }
    },
    {
      "permission": "read",
      "inputSchema": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "projectPath": {
            "type": "string",
            "maxLength": 1024
          }
        }
      },
      "handler": "pull_sources",
      "surfaces": [
        "workbench"
      ],
      "id": "pull:sources",
      "projectRequired": true
    },
    {
      "permission": "read",
      "inputSchema": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "projectPath": {
            "type": "string",
            "maxLength": 1024
          }
        }
      },
      "handler": "pull_choose_probe",
      "surfaces": [
        "workbench"
      ],
      "id": "pull:chooseProbe",
      "projectRequired": true
    },
    {
      "handler": "pull_icons",
      "id": "pull:icons",
      "surfaces": [
        "workbench"
      ],
      "permission": "read",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "ids": {
            "items": {
              "type": "string",
              "maxLength": 256
            },
            "maxItems": 64,
            "type": "array"
          },
          "projectPath": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "required": [
          "ids"
        ],
        "type": "object"
      },
      "projectRequired": true
    }
  ],
  "assetFiles": {
    "notices.txt": "feature-plugins/mc-pull/NOTICES.txt"
  },
  "tools": [
    {
      "name": "modmind_mc_capture_status",
      "action": "pull:status",
      "description": "查询当前项目采集包、实例与导入进度，区分基础采集和探针数据。"
    },
    {
      "name": "modmind_mc_capture_run",
      "action": "pull:run",
      "description": "从本地实例采集名称、基础图标与方块标识到当前项目，不启动游戏。"
    },
    {
      "name": "modmind_mc_capture_select",
      "action": "pull:select",
      "description": "切换当前项目的采集包，建筑预览会使用选中的实例资源。"
    },
    {
      "name": "modmind_mc_capture_export",
      "action": "pull:exportPack",
      "description": "将采集包导出为当前项目内的 ZIP，返回产物路径与大小。"
    },
    {
      "name": "modmind_mc_capture_import_probe",
      "action": "pull:importProbe",
      "description": "将本地已有的游戏内探针采集产物导入当前项目，需要现成的 index.json 和图片页。"
    }
  ]
}
