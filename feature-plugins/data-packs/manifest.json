{
  "format": "modmind-feature",
  "apiVersion": 2,
  "hostVersion": "1.5.0-plugintest",
  "id": "data-packs",
  "name": "数据包",
  "version": "1.0.0",
  "description": "创建、导入、图形编辑、校验和导出 Minecraft 数据包；支持模组与整合包项目，按需使用本地游戏资源。",
  "main": "main.cjs",
  "renderer": "renderer.js",
  "style": "renderer.css",
  "dependencies": [],
  "studioIds": [
    "minecraft-mod",
    "minecraft-modpack"
  ],
  "loaders": [
    "fabric",
    "quilt",
    "forge",
    "neoforge"
  ],
  "hostCapabilities": [
    "runtime",
    "diagnosticsV1"
  ],
  "views": [
    {
      "label": "数据包",
      "icon": "FileJson",
      "group": "内容",
      "component": "modpack-datapacks",
      "id": "modpack-datapacks",
      "order": 40
    }
  ],
  "capabilities": [
    {
      "name": "数据包",
      "id": "data-packs",
      "description": "配方、标签与简单掉落的图形编辑，完整源码回读、保存冲突保护与ZIP导出。复杂内容保留源码，校验不代替游戏验证。"
    }
  ],
  "actions": [
    {
      "permission": "read",
      "inputSchema": {
        "properties": {
          "root": {
            "type": "string",
            "maxLength": 512
          },
          "path": {
            "type": "string",
            "maxLength": 512
          },
          "operation": {
            "type": "string",
            "enum": [
              "list",
              "files",
              "read",
              "validate",
              "history"
            ]
          },
          "limit": {
            "maximum": 500,
            "minimum": 1,
            "type": "integer"
          },
          "query": {
            "type": "string",
            "maxLength": 200
          },
          "projectPath": {
            "type": "string",
            "maxLength": 1024
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "type": "object"
      },
      "handler": "query",
      "projectRequired": true,
      "id": "query",
      "surfaces": [
        "workbench"
      ]
    },
    {
      "permission": "write",
      "inputSchema": {
        "properties": {
          "root": {
            "type": "string",
            "maxLength": 512
          },
          "path": {
            "type": "string",
            "maxLength": 512
          },
          "limit": {
            "maximum": 500,
            "minimum": 1,
            "type": "integer"
          },
