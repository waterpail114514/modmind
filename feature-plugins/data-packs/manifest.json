  "tools": [
    {
      "name": "modmind_data_pack_query",
      "description": "List project data packs, paginate files, read exact source and baseline, validate a pack, or list recoverable history (operation history). Validation is scoped static validation, not proof of in-game behavior.",
      "action": "query"
    },
    {
      "name": "modmind_data_pack_write",
      "description": "Create a pack or entry, save exact JSON/function source with baseline conflict protection (null for new files), remove with recovery copy, export a validated ZIP inside the project, or restore a historyId with the baseline returned by query/history. Operations create-pack/create/save/remove/export/restore.",
      "action": "write"
    },
    {
      "name": "modmind_data_pack_items",
      "description": "Search paginated vanilla and selected local-instance item IDs and names for data pack authoring; does not download resources or start Minecraft.",
      "action": "catalog"
    }
  ]
}
