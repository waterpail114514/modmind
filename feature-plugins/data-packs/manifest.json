              "save",
              "create",
              "create-pack",
              "remove",
              "export",
              "restore"
            ]
          },
          "content": {
            "type": "string",
            "maxLength": 1048576
          },
          "baseline": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "id": {
            "type": "string",
            "maxLength": 256
          },
          "projectPath": {
            "type": "string",
            "maxLength": 1024
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "query": {
            "type": "string",
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "recipe-shaped",
              "recipe-shapeless",
              "item-tag",
              "block-tag",
              "loot-block",
              "advancement",
              "predicate",
              "function",
              "json"
            ]
          },
          "namespace": {
            "type": "string",
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "maxLength": 64
          },
          "historyId": {
            "type": "string",
            "maxLength": 100
          }
        },
        "additionalProperties": false,
        "type": "object"
      },
      "handler": "write",
      "projectRequired": true,
