{
  "name": "modmind",
  "version": "1.5.0-preview.4",
  "private": true,
  "description": "AI-assisted Minecraft mod development workspace",
  "main": "out/main/index.js",
  "author": "ModMind",
  "license": "AGPL-3.0-only",
  "sourceFingerprint": "sha256:235b5b247370dc5069a627962c848fb0d80f557114a51f51ebf5610db303f504",
  "scripts": {
    "models:sync": "node scripts/sync-model-context-registry.mjs && node scripts/sync-model-reasoning-registry.mjs",
    "predev": "node scripts/verify-workspace.mjs && node scripts/prepare-bundled-studios.mjs && node scripts/prepare-developer-kit.mjs",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/verify-workspace.mjs && node scripts/verify-gradle-wrapper.mjs && node scripts/prepare-bundled-studios.mjs && node scripts/prepare-developer-kit.mjs && npm run theme:check && node scripts/clean-build-output.mjs",
    "developer:kit": "node scripts/prepare-developer-kit.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run src && npm run test:mcp && npm run test:mac-policy && npm run test:gradle-wrapper && npm run test:ffmpeg",
    "test:mcp": "npm --prefix modmind-mcp-open-source test",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --pretty false && tsc --noEmit -p tsconfig.web.json --pretty false",
    "assets:icons": "node scripts/generate-icons.mjs && node scripts/generate-macos-assets.mjs && node scripts/generate-installer-assets.mjs && node android-twa/scripts/generate-icons.mjs",
    "assets:installer": "node scripts/generate-installer-assets.mjs",
    "version:patch": "npm version patch --no-git-tag-version",
    "test:ffmpeg": "node --test scripts/verify-ffmpeg.test.mjs",
    "predist:win": "node scripts/verify-ffmpeg.mjs --repair",
    "predist:win:unsigned": "node scripts/verify-ffmpeg.mjs --repair",
    "dist:win": "npm run build && electron-builder --win --config.forceCodeSigning=true && node scripts/verify-release.mjs && node scripts/prepare-update-artifacts.mjs",
    "dist:win:unsigned": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& npm run build && electron-builder --win && node scripts/verify-release.mjs --allow-unsigned && node scripts/prepare-update-artifacts.mjs",
    "dist:linux": "npm run build && electron-builder --linux AppImage zip",
    "dist:mac": "npm run dist:mac:release",
    "dist:mac:unsigned": "npm run build && node scripts/build-macos.mjs --allow-unsigned",
    "verify:release": "node scripts/verify-release.mjs",
    "dist:mac:arm64": "npm run build && node scripts/build-macos.mjs --arch arm64",
    "dist:mac:x64": "npm run build && node scripts/build-macos.mjs --arch x64",
    "dist:mac:release": "npm run build && node scripts/build-macos.mjs",
    "assets:mac": "node scripts/generate-macos-assets.mjs",
    "verify:mac": "node scripts/verify-macos-release.mjs",
    "test:mac-policy": "node --test scripts/macos-release-policy.test.mjs",
    "test:gradle-wrapper": "node --test scripts/verify-gradle-wrapper.test.mjs",
    "test:update-artifacts": "node --test scripts/prepare-update-artifacts.test.mjs scripts/verify-update-config.test.mjs",
    "test:reinstall-electron": "node scripts/reinstall-electron-smoke.mjs",
    "theme:generate": "node scripts/generate-theme-tokens.mjs",
    "theme:check": "node scripts/generate-theme-tokens.mjs --check && node scripts/check-theme-colors.mjs && npm run plugins:check",
    "plugins:generate": "node scripts/generate-plugin-templates.mjs",
    "plugins:check": "node scripts/generate-plugin-templates.mjs --check && node scripts/check-plugin-ui.mjs",
    "plugins:smoke": "node scripts/plugin-ui-smoke.mjs",
    "features:build": "node scripts/build-feature-plugins.mjs",
    "features:preview": "node scripts/feature-plugins-live-qa.mjs --preview",
    "features:smoke": "node scripts/feature-plugins-smoke.mjs",
    "dist:plugintest": "node scripts/dist-plugintest.mjs",
    "sync:mcp": "node scripts/sync-mcp-server.mjs --write",
    "pretest:mcp": "node scripts/verify-workspace.mjs --mcp && node scripts/patch-mcp-tests.mjs && node scripts/sync-mcp-server.mjs",
    "setup:tests": "node scripts/setup-mcp-tests.mjs",
    "verify:workspace": "node scripts/verify-workspace.mjs --mcp",
    "pretest": "node scripts/verify-workspace.mjs --mcp"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/marked": "^6.0.0",
    "@xmcl/asm": "1.0.1",
    "7zip-bin": "^5.2.0",
    "ajv": "^8.20.0",
    "cheerio": "^1.1.2",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "fast-xml-parser": "^5.11.2",
    "fzstd": "^0.1.1",
    "partial-json": "0.1.7",
    "pdfjs-dist": "4.10.38",
    "proper-lockfile": "^4.1.2",
    "semver": "7.8.5",
    "sharp": "^0.35.5",
    "smol-toml": "^1.9.1",
    "undici": "7.30.0",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@shaderfrog/glsl-parser": "7.0.1",
    "@tonejs/midi": "^2.0.28",
    "@types/node": "^22.10.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/semver": "7.7.1",
    "@types/three": "^0.180.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@xmcl/core": "^2.15.1",
    "@xmcl/installer": "^6.1.2",
    "@xyflow/react": "^12.11.2",
    "archiver": "^5.3.2",
    "driver.js": "1.9.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "ffmpeg-static": "^5.3.0",
    "ftbq-nbt": "^1.4.1",
    "jfxr": "^0.13.0",
    "json5": "^2.2.3",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.7",
    "monaco-editor": "^0.56.0",
    "playwright": "^1.64.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-virtuoso": "^4.18.13",
    "react-zoom-pan-pinch": "4.2.0",
    "three": "^0.180.0",
    "tone": "^15.1.22",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.11",
    "yaml": "^2.8.1"
  },
  "build": {
    "appId": "dev.modmind.desktop",
    "productName": "ModMind",
    "compression": "maximum",
    "protocols": [
      {
        "name": "ModMind Device Sync",
        "schemes": [
          "mcdev"
        ]
      }
    ],
    "copyright": "Copyright © ModMind contributors",
    "directories": {
      "output": "release"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE",
      "README.md",
      "TRADEMARKS.md",
      "THIRD_PARTY_NOTICES.md",
      "!android-twa/**"
    ],
    "asarUnpack": [
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/@napi-rs/**",
      "node_modules/7zip-bin/**"
    ],
    "extraResources": [
      {
        "from": "resources/developer-kit",
        "to": "developer-kit",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/bundled-studios",
        "to": "bundled-studios",
        "filter": [
          "index.json",
          "studio-mod/**/*",
          "studio-modpack/**/*",
          "studio-server-plugin/**/*"
        ]
      },
      {
        "from": "resources/reinstall-app.ps1",
        "to": "reinstall-app.ps1"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/service-config.json",
        "to": "service-config.json"
      },
      {
        "from": "resources/codex-skills",
        "to": "codex-skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/gradle-wrapper",
        "to": "gradle-wrapper",
        "filter": [
          "gradlew",
          "gradlew.bat",
          "gradle-wrapper.jar",
          "UPSTREAM.txt",
          "LICENSE"
        ]
      },
      {
        "from": "resources/plugin-host",
        "to": "plugin-host",
        "filter": [
          "*.mjs"
        ]
      },
      {
        "from": "resources/plugin-templates",
        "to": "plugin-templates",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "resources/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico",
      "publish": {
        "provider": "generic",
        "url": "https://etherup.cn-nb1.rains3.com/"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "include": "resources/installer.nsh",
      "installerHeader": "resources/installer-header.bmp",
      "installerSidebar": "resources/installer-sidebar.bmp",
      "uninstallerSidebar": "resources/installer-sidebar.bmp",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "zip"
      ],
      "icon": "resources/icon.png",
      "category": "Development"
    }
  },
  "overrides": {
    "dompurify": "3.4.16",
    "undici": "$undici"
  }
}
