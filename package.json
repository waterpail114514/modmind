{
  "name": "modmind",
  "version": "1.1.3",
  "private": true,
  "description": "AI-assisted Minecraft mod development workspace",
  "main": "out/main/index.js",
  "author": "ModMind",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --pretty false && tsc --noEmit -p tsconfig.web.json --pretty false",
    "version:patch": "npm version patch --no-git-tag-version",
    "dist:win": "npm run build && electron-builder --win --config.forceCodeSigning=true && node scripts/verify-release.mjs",
    "dist:win:unsigned": "npm run build && electron-builder --win --config.win.signAndEditExecutable=false && node scripts/verify-release.mjs --allow-unsigned",
    "dist:linux": "npm run build && electron-builder --linux AppImage zip",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@types/marked": "^6.0.0",
    "@xmcl/core": "^2.15.1",
    "@xmcl/installer": "^6.1.2",
    "extract-zip": "^2.0.1",
    "fast-xml-parser": "^5.2.5",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.7",
    "monaco-editor": "^0.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "7.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "playwright": "^1.54.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "dev.modmind.desktop",
    "productName": "ModMind",
    "copyright": "Copyright © ModMind contributors",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "vendor/blockbench",
        "to": "blockbench",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "vendor/gradle-wrapper",
        "to": "gradle-wrapper",
        "filter": [
          "gradlew",
          "gradlew.bat",
          "gradle-wrapper.jar",
          "UPSTREAM.txt",
          "LICENSE"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "zip"
      ],
      "icon": "resources/icon.png",
      "category": "Development"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true,
    "ffmpeg-static@5.3.0": true
  }
}
