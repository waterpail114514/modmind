{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "strict": true,
    "types": [
      "node",
      "electron"
    ],
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "feature-plugins/*/src/main/**/*.ts",
    "feature-plugins/*/main.ts",
    "feature-plugins/sdk/native.ts",
    "feature-plugins/sdk/mediaRuntime.ts",
    "feature-plugins/sdk/nativeResources.ts"
  ]
}
